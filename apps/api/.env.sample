# =============================================================================
# BRUTE FORCE GAME - BACKEND API ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Primary database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brute_force"

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Access token secret (minimum 32 characters recommended)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Refresh token secret (minimum 32 characters recommended) 
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# Token expiration times
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
# Redis connection URL for session management and caching
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# API throttling configuration (requests per second per user)
THROTTLE_TTL=60
THROTTLE_LIMIT=2

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins or "*" for all
# Example: "http://localhost:3000,https://example.com"
# Used for both REST API endpoints and SSE (Server-Sent Events) connections
CORS_ORIGINS="*"

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Legacy - deprecated, use CORS_ORIGINS instead)
# -----------------------------------------------------------------------------
# Frontend URL for CORS and WebSocket connections
# FRONTEND_URL="http://localhost:3000"

# =============================================================================
# ADMIN CLI USAGE
# =============================================================================
#
# Create Genesis Block (first block to start the game):
#   pnpm --filter api cli create-genesis --password "test123" --hint "A test password"
#
# Required environment variables for CLI:
#   - DATABASE_URL: PostgreSQL connection string
#
# Optional CLI parameters:
#   --length <number>: Override password length in difficulty config
#   --charset <string>: Override charset (e.g., "lowercase,alphanumeric")
#

# -----------------------------------------------------------------------------
# OPENAI API
# -----------------------------------------------------------------------------
# OpenAI API key for AI-generated password creation
OPENAI_API_KEY="your-openai-api-key"

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Legacy - for migration only)
# -----------------------------------------------------------------------------
# These variables are only needed if migrating from Supabase
# SUPABASE_URL="your-supabase-url"
# SUPABASE_ANON_KEY="your-supabase-anon-key"

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
#
# 1. Database Setup:
#    - Ensure PostgreSQL is running on localhost:5432
#    - Create database named 'brute_force'
#    - Run 'pnpm prisma:migrate' to apply schema
#    - Run 'pnpm prisma:seed' to populate initial data
#
# 2. Redis Setup:
#    - Redis is used for session management and caching
#    - Default connection: redis://localhost:6379
#
# 3. Security:
#    - Change JWT secrets in production
#    - Use strong, unique secrets
#    - Enable HTTPS in production
#
# 4. OpenAI Integration:
#    - Required for AI-generated password creation
#    - Get API key from https://platform.openai.com/
#
# 5. Rate Limiting:
#    - Default: 2 requests per second per user
#    - Adjust THROTTLE_LIMIT based on your needs
#
# 6. Frontend Connection:
#    - Ensure FRONTEND_URL matches your frontend URL
#    - Used for CORS and WebSocket connections
#